diff --git a/drivers/power/supply/power_supply_core.c b/drivers/power/supply/power_supply_core.c
index bd49ae732..c74800dba 100644
--- a/drivers/power/supply/power_supply_core.c
+++ b/drivers/power/supply/power_supply_core.c
@@ -21,6 +21,9 @@
 #include <linux/power_supply.h>
 #include <linux/property.h>
 #include <linux/thermal.h>
+// 先在文件头部添加必要头文件（若已存在可忽略）
+#include <linux/reboot.h>
+#include <linux/spinlock.h>
 #include "power_supply.h"
 
 /* exported for the APM Power driver, APM emulation */
@@ -85,7 +88,61 @@ static void power_supply_changed_work(struct work_struct *work)
 	unsigned long flags;
 	struct power_supply *psy = container_of(work, struct power_supply,
 						changed_work);
+	// 关键修正1：定义共用体变量，匹配 power_supply_get_property 参数类型
+	union power_supply_propval prop_val;
+	enum power_supply_property prop;
+	int ret;
+	bool is_charging_online = false;
+	bool is_system_running = false;
+	enum power_supply_type psy_type;
+	// 新增：定义日志输出用的名称变量，避免直接访问出错
+	const char *psy_name = "unknown";
+
+	dev_dbg(&psy->dev, "%s\n", __func__);
 
+	// ===================== 修正后：充电自动开机核心逻辑（开始） =====================
+	// 双重防护：避免 psy 或 psy->desc 为空指针
+	if (psy && psy->desc) {
+		// 关键修正3：获取电源名称（从 desc 中读取，而非直接 psy->name）
+		psy_name = psy->desc->name ? psy->desc->name : "unknown";
+		psy_type = psy->desc->type;
+
+		// 匹配 USB 各类充电类型和 AC 充电（MAINS）
+		if ((psy_type == POWER_SUPPLY_TYPE_USB ||
+		     psy_type == POWER_SUPPLY_TYPE_USB_DCP ||
+		     psy_type == POWER_SUPPLY_TYPE_USB_CDP ||
+		     psy_type == POWER_SUPPLY_TYPE_USB_TYPE_C ||
+		     psy_type == POWER_SUPPLY_TYPE_MAINS)) {
+			prop = POWER_SUPPLY_PROP_ONLINE;
+			// 关键修正2：传入共用体指针，替换 bool 指针，解决类型不兼容
+			ret = power_supply_get_property(psy, prop, &prop_val);
+			if (ret < 0) {
+				pr_warn("[Charge Auto Power On] %s: failed to get online status, ret=%d\n",
+					psy_name, ret);
+				goto out;
+			}
+
+			// 关键修正4：从共用体 intval 成员读取值，转换为 bool 类型
+			is_charging_online = (prop_val.intval != 0);
+
+			// 判断系统是否处于运行状态（避免重复触发开机）
+			is_system_running = (system_state == SYSTEM_RUNNING);
+
+			// 满足条件：关机状态 + 充电接入
+			if (!is_system_running && is_charging_online) {
+				pr_info("[Charge Auto Power On] Detected %s charge inserted, triggering auto power on...\n",
+					(psy_type == POWER_SUPPLY_TYPE_MAINS) ? "AC" : "USB");
+
+				// 内核标准开机接口（通用性强，推荐）
+				kernel_restart(NULL);
+
+				// 平台专用开机接口（按需启用，需自行实现）
+				// platform_trigger_power_on();
+			}
+		}
+	}
+out:
+	// ===================== 修正后：充电自动开机核心逻辑（结束） =====================
 	dev_dbg(&psy->dev, "%s\n", __func__);
 
 	spin_lock_irqsave(&psy->changed_lock, flags);
